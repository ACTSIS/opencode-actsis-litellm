{
  "name": "opencode-actsis-litellm",
  "version": "0.1.0",
  "description": "OpenCode plugin that adds an ACTSIS LiteLLM gateway as a dynamic provider with OAuth2 PKCE login and dynamic model catalog.",
  "type": "module",
  "main": "./dist/tui.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/tui.js"
    },
    "./server": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./src/tui.tsx",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "bundle": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.25"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "@types/node": "^22",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.9.12",
    "tsup": "^8.5.1",
    "typescript": "^5.7",
    "vitest": "^3"
  },
  "engines": {
    "opencode": ">=1.14.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "litellm",
    "oauth",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACTSIS/opencode-actsis-litellm.git"
  },
  "homepage": "https://github.com/ACTSIS/opencode-actsis-litellm#readme",
  "bugs": {
    "url": "https://github.com/ACTSIS/opencode-actsis-litellm/issues"
  },
  "license": "MIT",
  "types": "./src/index.ts"
}
